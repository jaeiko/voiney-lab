CASCADE_VAD_ENDPOINT_SILENCE_MS=1000
CASCADE_VAD_MIN_SPEECH_MS=240
CASCADE_VAD_MAX_UTTERANCE_MS=15000
CASCADE_VAD_COOLDOWN_MS=300
CHAT_MODEL=grok-4
