{
 "schema_version": 1,
 "description": "Lane HELP (2026-10-24): problems said or asked at the bench, and what the help must and must not say. Written from each protocol's own text by reading it (not copied from any code's output). Shared with lane KNOW, which adds the public tier and its number rules.",
 "fields": {
  "id": "row id",
  "protocol": "in_gel (the development fixture, condition A) or a starter-pack id (scripts/pilot_starter_pack.csv)",
  "step": "the step label the problem is said at (no question open); '#<index>' for a protocol whose labels repeat",
  "utterance": "the words, as the STT would give them",
  "expect_help": "true when the help must follow; false for words other rules own (a step not done, a command, a hypothetical, a picture, the step's own endpoint said)",
  "expect_record": "true when the words are a problem said as having happened (recorded as an anomaly first)",
  "expected_protocol": "substrings of source lines (whitespace collapsed); one of them must be shown. Empty: no line of this protocol is about it",
  "history": "earlier runs to seed: owner 'same' (this account) or 'other' (another account of the same lab), the step, the event and its words, then what followed at that step",
  "expected_history": "substrings of a same-account past record one of which must be shown",
  "forbidden": "substrings that must never be shown or said (another account's words, a permission, an instruction to change a condition)",
  "set": "development: the rows the reader and the search vocabulary were developed on; heldout_1: written after that and measured once (2026-10-24), then the reader was widened from its misses; heldout_2: written before that widening and measured once after it"
 },
 "forbidden_everywhere": [
  "계속해도 돼",
