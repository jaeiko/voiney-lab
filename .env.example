XAI_API_KEY=replace-with-your-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_STT_VAD_THRESHOLD=0.5
XAI_STT_FILLER_WORDS=0
CASCADE_VAD_MODE=3
CASCADE_VAD_ONSET_VOICED_FRAMES=4
CASCADE_VAD_ONSET_WINDOW_FRAMES=6
CASCADE_VAD_PREFIX_MS=300
CASCADE_VAD_ENDPOINT_SILENCE_MS=1000
CASCADE_VAD_MIN_SPEECH_MS=240
CASCADE_VAD_MAX_UTTERANCE_MS=15000
CASCADE_VAD_COOLDOWN_MS=300
CHAT_MODEL=grok-4
WORKER_MODEL=grok-4
PROTOCOL_ANALYSIS_MODEL=grok-4
# The current product uses the Cascade STT -> agent -> TTS path only.
# Leo is the documented calm, authoritative default; custom xAI voice IDs work.
TTS_VOICE=leo
LAB_MANAGER_EMAIL=lab-manager@example.invalid
VOICE_WORKFLOW_AGENT_FROM_EMAIL=voice_workflow_agent@example.invalid

# Required server policy. Use absolute paths for catalog files.
VOICE_WORKFLOW_AGENT_SAFETY_CATALOG=/absolute/path/to/approved_catalog.sqlite
VOICE_WORKFLOW_AGENT_USAGE_SCOPE=test_only
VOICE_WORKFLOW_AGENT_FACILITY_ID=
VOICE_WORKFLOW_AGENT_SESSION_LANGUAGE=ko
VOICE_WORKFLOW_AGENT_ALLOWED_LANGUAGES=ko,en,vi

# Optional arbitrary-PDF protocol catalog. The directory must be absolute and
# ignored by Git. Upload/analysis is unavailable while disabled.
VOICE_WORKFLOW_AGENT_PROTOCOL_ENABLED=false
VOICE_WORKFLOW_AGENT_PROTOCOL_DATA_DIR=/absolute/ignored/runtime/protocol-catalog
# Explicit convenience for demo/reference/test scopes only; operational scope
# always disables automatic development activation.
VOICE_WORKFLOW_AGENT_AUTO_ACTIVATE_READY_UPLOADS=false

# Optional tenant/RBAC/source workspace. Both data stores must use absolute,
# ignored runtime directories. Non-operational scope has one allowlisted local
# lab-admin profile by default; provide an explicit JSON profile list to model
# researcher/reviewer/admin roles in a demo.
VOICE_WORKFLOW_AGENT_WORKSPACE_ENABLED=false
VOICE_WORKFLOW_AGENT_WORKSPACE_DATA_DIR=/absolute/ignored/runtime/workspace
VOICE_WORKFLOW_AGENT_ANALYTICS_RETENTION_DAYS=90
VOICE_WORKFLOW_AGENT_DEV_AUTH_PROFILES=

# Operational workspace mode requires all three OIDC values. Tokens must use a
# verified RS256/ES256 signature and include issuer, audience, exp, iat, sub,
# tenant, and roles claims. The local membership remains an additional gate.
VOICE_WORKFLOW_AGENT_OIDC_ISSUER=
VOICE_WORKFLOW_AGENT_OIDC_AUDIENCE=
VOICE_WORKFLOW_AGENT_OIDC_JWKS_URL=
VOICE_WORKFLOW_AGENT_OIDC_TENANT_CLAIM=organization_id
VOICE_WORKFLOW_AGENT_OIDC_ROLES_CLAIM=roles
VOICE_WORKFLOW_AGENT_OIDC_NAME_CLAIM=name

# Connector rows store opaque secret:// references only. This JSON maps each
# reference to a server-side environment-variable NAME; it must never contain an
# access token itself. Define the named variables in the process secret manager.
VOICE_WORKFLOW_AGENT_SECRET_REFERENCES={}

# Optional procedure support. Set both paths or leave both empty.
VOICE_WORKFLOW_AGENT_PROCEDURE_CATALOG=
VOICE_WORKFLOW_AGENT_PROCEDURE_STORE=

# Optional Moss in-memory retrieval. Keep disabled until a reviewed index exists.
VOICE_WORKFLOW_AGENT_MOSS_ENABLED=false
MOSS_PROJECT_ID=replace-with-moss-project-id
MOSS_PROJECT_KEY=replace-with-moss-project-key
MOSS_INDEX_NAME=voice_workflow_agent-approved-safety
MOSS_MODEL_ID=moss-minilm

VOICE_WORKFLOW_AGENT_MOSS_ALLOWED_SCOPES=demo,reference_only
VOICE_WORKFLOW_AGENT_MOSS_ALPHA=0.65
VOICE_WORKFLOW_AGENT_MOSS_CANDIDATE_LIMIT=64
VOICE_WORKFLOW_AGENT_MOSS_QUERY_TIMEOUT_MS=250
VOICE_WORKFLOW_AGENT_MOSS_LOAD_TIMEOUT_SECONDS=60
VOICE_WORKFLOW_AGENT_MOSS_AUTO_REFRESH=false
VOICE_WORKFLOW_AGENT_MOSS_REFRESH_SECONDS=600

# Optional, read-only authoritative references. A profile or 1-5 explicit
# HTTPS domains is required; do not place credentials in these values.
EXTERNAL_REFERENCES_ENABLED=false
EXTERNAL_REFERENCE_DOMAIN_PROFILE=candidate_a
EXTERNAL_REFERENCE_MODEL=grok-4.6
EXTERNAL_REFERENCE_TIMEOUT_SECONDS=20
EXTERNAL_REFERENCE_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_REFERENCE_READ_TIMEOUT_SECONDS=15
EXTERNAL_REFERENCE_CACHE_TTL_SECONDS=900
EXTERNAL_REFERENCE_MAX_CITATIONS=5
EXTERNAL_REFERENCE_ALLOWED_DOMAINS=
EXTERNAL_REFERENCE_ENRICHMENT_BUDGET_SECONDS=4

# Optional project-specific read-only Answer/Source/Visual LLM roles. The
# deterministic server remains the sole workflow/report authority. A short
# primary budget prevents these calls from delaying the local answer/TTS.
# Keep disabled until one account/model passes all three role schemas, semantic
# admission, and the concurrent production-transport probe; schema-only success
# is insufficient.
VOICE_WORKFLOW_AGENT_MULTI_BRAIN_ENABLED=false
VOICE_WORKFLOW_AGENT_MULTI_BRAIN_MODEL=grok-4.6
VOICE_WORKFLOW_AGENT_ANSWER_BRAIN_PRIMARY_BUDGET_SECONDS=1.25
VOICE_WORKFLOW_AGENT_ANSWER_BRAIN_TIMEOUT_SECONDS=8
VOICE_WORKFLOW_AGENT_PLANNER_BRAIN_TIMEOUT_SECONDS=6

# Optional general Grok explanation after every admitted authoritative tier
# is insufficient. This is never protocol evidence and cannot answer operations.
SUPPLEMENTAL_MODEL_KNOWLEDGE_ENABLED=false
SUPPLEMENTAL_MODEL_KNOWLEDGE_MODEL=grok-4.6
SUPPLEMENTAL_MODEL_KNOWLEDGE_TIMEOUT_SECONDS=8

# Explicit web-image discovery returns a source link unless display rights and
# safely proxied bytes can be verified. It never hotlinks a remote image.
WEB_VISUAL_SEARCH_ENABLED=false

# Explicit instructional image generation only; never automatic per step.
VOICE_WORKFLOW_AGENT_GENERATED_VISUALS_ENABLED=false

# Cascade keeps a longer interruption-only prefix without changing idle turns.
CASCADE_BARGE_IN_PREFIX_MS=800

# Noise-aware interruption gate. A shared lab is loud: WebRTC VAD alone flags
# glassware, chairs and fume hoods as speech, and before this gate any one of
# them ducked the agent mid-answer. The gate adds a level criterion measured
# against this room, so a sound must be BOTH speech-shaped (the endpoint
# detector's job) and loud/sustained enough (the gate's job) before the
# researcher ever sees an interruption. Every value is bounded and validated.
#
# Set to 0 to restore the pre-hardening "any VAD onset interrupts" behaviour.
# Only useful for bisecting a field problem.
CASCADE_BARGE_IN_GATE_ENABLED=1
# How many times louder than the measured ambient floor a frame must be.
CASCADE_BARGE_IN_ONSET_SNR_RATIO=3.0
# Absolute floor (full-scale RMS) so a near-silent room cannot pass on ratio
# arithmetic alone.
CASCADE_BARGE_IN_ONSET_ABSOLUTE_RMS=0.006
# Minimum-statistics ambient tracker: follow the level down quickly, creep up
# slowly, and stay inside these bounds.
CASCADE_BARGE_IN_NOISE_FLOOR_INITIAL_RMS=0.004
CASCADE_BARGE_IN_NOISE_FLOOR_MIN_RMS=0.0015
CASCADE_BARGE_IN_NOISE_FLOOR_MAX_RMS=0.03
CASCADE_BARGE_IN_NOISE_FLOOR_RISE=0.02
CASCADE_BARGE_IN_NOISE_FLOOR_FALL=0.25
# Deaf window right after TTS starts, covering the agent's own playback onset
# returning through the room when browser echo cancellation is weak.
CASCADE_BARGE_IN_PLAYBACK_COOLDOWN_MS=120
# Sustained level required inside the window below; shorter is an impulse.
CASCADE_BARGE_IN_MIN_SPEECH_MS=120
CASCADE_BARGE_IN_WINDOW_MS=400

# Optional speaker diarization (documented xAI batch STT field). Off by default.
# Diarization separates voices; it is NOT speaker verification and NOT biometric
# authentication. A diarized label is an acoustic, session-scoped label that is
# associated with a lab member only by an explicit human confirmation, and the
# association is discarded when the session ends. No voiceprint is stored.
XAI_STT_DIARIZE=0
VOICE_WORKFLOW_AGENT_MAX_SESSION_SPEAKERS=4

# Optional runtime Korean presentation translation of approved English source
# text. Off by default: a reviewer-approved Korean sidecar always wins, and
# without one the exact approved source is shown rather than generated Korean.
# When enabled, every candidate translation is mechanically checked for
# preserved numbers, units and identifiers and discarded if any changed. A
# runtime translation is always labelled 자동 번역, never 검증된 번역.
VOICE_WORKFLOW_AGENT_PRESENTATION_TRANSLATION_ENABLED=0
VOICE_WORKFLOW_AGENT_PRESENTATION_TRANSLATION_MODEL=grok-4.6
VOICE_WORKFLOW_AGENT_PRESENTATION_TRANSLATION_MAX_CHARS=1200
VOICE_WORKFLOW_AGENT_PRESENTATION_TRANSLATION_TIMEOUT=12

VOICE_WORKFLOW_AGENT_GENERATED_VISUAL_MODEL=grok-imagine-image-quality
VOICE_WORKFLOW_AGENT_GENERATED_VISUAL_TIMEOUT_SECONDS=60

# Event-driven experiment records. Use an ignored runtime path in development.
VOICE_WORKFLOW_AGENT_EXPERIMENT_REPORTS_ENABLED=false
VOICE_WORKFLOW_AGENT_EXPERIMENT_REPORT_DB=/absolute/ignored/runtime/experiment_reports.sqlite

# How many researcher-confirmed repetitions of a source-defined repeat range
# run before the server stops and asks whether to continue, pause, or request
# review. This is an operational guardrail only: the source protocol does not
# define a maximum iteration count and this value must never be presented as
# one. Leave it unset to use the default of 5.
# VOICE_WORKFLOW_AGENT_REPEAT_CONFIRMATION_REVIEW_THRESHOLD=5

# Required to access GET /api/admin/metrics. Use a long random secret in a
# secret manager; never place a real token in a committed environment file.
VOICE_WORKFLOW_AGENT_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Opt-in local real-voice STT evidence. Disabled means no audio is retained.
# When enabled, both WAV and sanitized metadata stay under the ignored runtime
# tree and oldest pairs are deleted after the bounded limit.
VOICE_WORKFLOW_AGENT_STT_DIAGNOSTICS_ENABLED=false
VOICE_WORKFLOW_AGENT_STT_DIAGNOSTIC_DIR=/absolute/path/inside/repository/data/runtime/stt-diagnostics
VOICE_WORKFLOW_AGENT_STT_DIAGNOSTIC_MAX_FILES=20
