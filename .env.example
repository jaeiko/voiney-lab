## Voiney Lab 설정. scripts/migrate_env.py 가 영역별로 정리했다.
## '## ' 로 시작하는 줄은 도구가 쓰는 주석이라, 다시 정리할 때 새로 쓴다.
## 이름 표: src/voiney_lab/setting_names.py

## ── 공급자 키 ──
## Anthropic API 키 (공급자가 anthropic 인 역할)
ANTHROPIC_API_KEY=
## ElevenLabs API 키 (음성 공급자 elevenlabs)
ELEVENLABS_API_KEY=
## Gemini API 키 (공급자가 google 이고 Vertex AI 를 쓰지 않을 때)
GEMINI_API_KEY=
# Vertex AI express mode (GOOGLE_GENAI_USE_ENTERPRISE=true); without it, ADC.
## Vertex AI API 키 (express 모드; 없으면 ADC)
GOOGLE_API_KEY=
## Vertex AI 지역
GOOGLE_CLOUD_LOCATION=global
## Vertex AI 구글 클라우드 프로젝트 (키 없이 ADC 로 쓸 때 필수)
GOOGLE_CLOUD_PROJECT=
## true 면 google 역할이 Vertex AI(Gemini Enterprise Agent Platform)로 감
GOOGLE_GENAI_USE_ENTERPRISE=false
# Lane KNOW: the Moss project credentials for the public knowledge search
# (VOINEY_LAB_PUBLIC_KNOWLEDGE_ENABLED below). Moss's own names, kept as they are.
## Moss 프로젝트 id (공개 지식 검색; VOINEY_LAB_PUBLIC_KNOWLEDGE_ENABLED 이 true 면 필수)
MOSS_PROJECT_ID=
## Moss 프로젝트 키 (공개 지식 검색)
MOSS_PROJECT_KEY=
## OpenAI API 키 (공급자가 openai 인 역할)
OPENAI_API_KEY=
## Google Cloud Speech-to-Text·Text-to-Speech API 키 (음성 공급자 google_cloud)
VOINEY_LAB_GOOGLE_SPEECH_API_KEY=
# STT-only google_cloud_v2: explicit ADC JSON outside every git repository.
# Service-account key, AWS WIF or developer user ADC; chmod 600 for all three.
## Google STT V2 ADC JSON 경로 (서비스 계정·AWS WIF·개발자, 모든 저장소 밖·소유자만 접근)
VOINEY_LAB_GOOGLE_STT_V2_CREDENTIALS_FILE=
# Only for a role or the speech path set to xai.
# A key is never committed: it goes in .env only.
## xAI API 키 (공급자를 xai 로 둔 역할·STT·TTS)
XAI_API_KEY=
## xAI API 주소
XAI_BASE_URL=https://api.x.ai/v1

## ── OCR ──
## NAVER CLOVA OCR 호출 주소 (https)
VOINEY_LAB_CLOVA_OCR_INVOKE_URL=
## CLOVA OCR 비밀 키
VOINEY_LAB_CLOVA_OCR_SECRET=
## Google Cloud Vision API 키
VOINEY_LAB_GOOGLE_VISION_API_KEY=
# Optional OCR for pages with no usable text layer (scans). List one or both
# engines: clova (NAVER CLOVA OCR, Korean and handwriting), google (Google
# Cloud Vision, English). Leave a value empty to disable that engine; with
# none configured the OCR endpoint returns protocol_ocr_not_configured.
## 쓸 OCR 엔진: clova, google (쉼표로)
VOINEY_LAB_OCR_PROVIDERS=

## ── 모델 ──
# Every role below is written down. The table says "설정 필요" for each role's
# provider and model, and the code assumes nothing for them (lanes PL, AN and RA
# removed the old xai fallback): an unset router, answer, translation, analysis
# or supplemental role is refused by the name of the missing setting, an unset
# report writer stays off, and an unset speech provider (VOINEY_LAB_STT_PROVIDER,
# VOINEY_LAB_TTS_PROVIDER) means no speech. Write every one.
#
# The values in use on 2026-10-10: analysis and translation google gemini-3.8-flash
# at reasoning low, router, answer and the outside-PDF explanation openai
# gpt-6-luna, report prose google gemini-3.8-flash. Each needs the provider's key
# above; copied as it is, a role with no key fails when it is called, by name.
## PDF 프로토콜 분석 모델 (분석에 필수)
VOINEY_LAB_ANALYSIS_MODEL=gemini-3.8-flash
## 긴 문서를 조각으로 나눠 분석할 때 한 번에 분석하는 조각 수 (1–16). 조각 분석 중 공급자가 429 를 돌려주면 그 문서의 남은 조각은 절반으로 줄여 시작 (줄 AN2 결정 3)
VOINEY_LAB_ANALYSIS_PIECE_CONCURRENCY=8
## PDF 프로토콜 분석 공급자
VOINEY_LAB_ANALYSIS_PROVIDER=google
## 프로토콜 분석 추론 (low/medium/high/xhigh)
VOINEY_LAB_ANALYSIS_REASONING=low
## 첫 분석 뒤 근거 검사에 실패한 항목(원문에 없음·근거를 못 찾음)만 그 쪽 글과 함께 한 번 더 물어 원문 그대로의 구간을 받음 (분석마다 1회, 긴 문서는 조각마다). 받은 구간도 같은 근거 검사를 거치고 값이 다르면 카드로 남김. false 면 끔 (줄 AN4 결정 1)
VOINEY_LAB_ANALYSIS_REQUOTE=true
## 실험: 분석 공급자가 google 일 때 분석 JSON 스키마를 응답 문법(response_json_schema)으로 보냄 (줄 EV3 결정 2)
VOINEY_LAB_ANALYSIS_RESPONSE_GRAMMAR=false
## Answer 역할 1차 응답 예산 (초)
VOINEY_LAB_ANSWER_BRAIN_PRIMARY_BUDGET_SECONDS=1.25
## Answer 역할 제한 시간 (초)
VOINEY_LAB_ANSWER_BRAIN_TIMEOUT_SECONDS=8
## 답변 모델
VOINEY_LAB_ANSWER_MODEL=gpt-6-luna
## 답변 공급자: 대화, multi-brain
VOINEY_LAB_ANSWER_PROVIDER=openai
## 답변 추론
VOINEY_LAB_ANSWER_REASONING=
## AI 도식(SVG) 생성 모델 (OpenAI Responses; 키는 OPENAI_API_KEY)
VOINEY_LAB_DRAWN_DIAGRAM_MODEL=gpt-6-luna
## AI 도식 생성 제한 시간 (초, 3–60)
VOINEY_LAB_DRAWN_DIAGRAM_TIMEOUT_SECONDS=20
## 분석·번역·보고서 Gemini 요청의 안전 필터: relaxed(서비스가 받는 가장 느슨한 값, 기본) / default(보내지 않음, 서비스 기본) / strict(가장 엄격 — 올리는 길). 음성 턴 역할은 해당 없음 (줄 GM 결정 1)
VOINEY_LAB_GEMINI_SAFETY=relaxed
## Google STT V2 내장 잡음 제거 (사람 음성 시험 뒤 확정)
VOINEY_LAB_GOOGLE_STT_V2_DENOISE=true
## Google STT V2 지역 (chirp_3 지원 지역을 사람이 확인)
VOINEY_LAB_GOOGLE_STT_V2_LOCATION=us
## Google STT V2 요청의 Google Cloud 프로젝트 ID
VOINEY_LAB_GOOGLE_STT_V2_PROJECT=
## LLM 라우터 제한 시간 (초, 0.2–30)
VOINEY_LAB_LLM_ROUTER_TIMEOUT_SECONDS=2.5
## Planner 역할 제한 시간 (초)
VOINEY_LAB_PLANNER_BRAIN_TIMEOUT_SECONDS=6
## 프로토콜 분석 호출 제한 시간 (초, 30–3600, 백그라운드 작업)
VOINEY_LAB_PROTOCOL_ANALYSIS_TIMEOUT_SECONDS=600
## 분석·번역·보고서 호출이 429·일시적 5xx 를 받으면 같은 요청을 다시 보내는 최대 횟수 (0–10, 0 이면 끔; 줄 AN2 결정 1)
VOINEY_LAB_PROVIDER_RETRY_MAX=5
## 다시 보내기 전 기다림의 상한 (초). 공급자가 이보다 오래 기다리라고 하면 다시 보내지 않음
VOINEY_LAB_PROVIDER_RETRY_MAX_WAIT_SECONDS=60
## 실험 보고서 서술 모델
VOINEY_LAB_REPORT_MODEL=gemini-3.8-flash
## 실험 보고서 서술 공급자
VOINEY_LAB_REPORT_PROVIDER=google
## 보고서 서술 추론
VOINEY_LAB_REPORT_REASONING=
## 보고서 서술 제한 시간 (초)
VOINEY_LAB_REPORT_WRITER_TIMEOUT_SECONDS=25
## 검토 카드로 묻는 확인 필요 항목 수의 상한 (1–500). 넘는 분석은 카드를 만들지 않고 추론 한 단계 위로 자동 다시 분석 1회, 그래도 넘으면 카드 없이 안내 (줄 RV2 결정 c)
VOINEY_LAB_REVIEW_MAX_ITEMS=12
## 항목이 많아 자동으로 다시 분석할 때 그 문서에 쓸 수 있는 분석 호출 수 상한 (조각 문서는 조각마다 2로 셈, 0 이면 다시 분석하지 않음; 줄 RV2 결정 c)
VOINEY_LAB_REVIEW_REANALYSIS_MAX_CALLS=16
## LLM 라우터 모델
VOINEY_LAB_ROUTER_MODEL=gpt-6-luna
## LLM 라우터 공급자 (xai/anthropic/openai/google)
VOINEY_LAB_ROUTER_PROVIDER=openai
## LLM 라우터 추론 (none/low/medium/high/xhigh/max)
VOINEY_LAB_ROUTER_REASONING=
## xAI STT 간투사 받아쓰기 (0/1, xai 만 씀)
VOINEY_LAB_STT_FILLER_WORDS=0
## 세션 입력 언어가 auto 일 때 쓸 언어 ko/en/vi (Google STT v1·v2 는 비우면 ko)
VOINEY_LAB_STT_LANGUAGE=
# The current product uses the Cascade STT -> agent -> TTS path only.
# Speech providers: elevenlabs (ELEVENLABS_API_KEY), google_cloud
# (VOINEY_LAB_GOOGLE_SPEECH_API_KEY) and xai (XAI_API_KEY). Left empty there is no
# provider: a turn's transcription or speech is refused by the setting's name.
# google_cloud_v2 is STT only (service-account JSON, no API key); set its model
# to chirp_3 or leave it empty when selecting it. TTS keeps its own provider.
# An empty VOINEY_LAB_TTS_VOICE is the provider's default voice --
# google_cloud: ko-KR-Chirp3-HD-Charon (Chirp 3 HD). A voice name belongs
# to one provider, so change it together with the provider.
## 음성 인식 모델
VOINEY_LAB_STT_MODEL=scribe_v2
## 음성 인식 공급자: xai, google_cloud, google_cloud_v2, elevenlabs
VOINEY_LAB_STT_PROVIDER=elevenlabs
## 음성 인식 요청 제한 시간 (초, 1–300)
VOINEY_LAB_STT_TIMEOUT_SECONDS=120
## xAI STT 음성 감지 임계값 (0–1, xai 만 씀)
VOINEY_LAB_STT_VAD_THRESHOLD=0.5
## PDF 밖 설명 모델
VOINEY_LAB_SUPPLEMENTAL_MODEL=gpt-6-luna
## 보조 모델 지식 제한 시간 (초, 1–15)
VOINEY_LAB_SUPPLEMENTAL_MODEL_KNOWLEDGE_TIMEOUT_SECONDS=8
## PDF 밖 설명 공급자: 보조 모델 지식
VOINEY_LAB_SUPPLEMENTAL_PROVIDER=openai
## PDF 밖 설명 추론
VOINEY_LAB_SUPPLEMENTAL_REASONING=low
## 번역 모델
VOINEY_LAB_TRANSLATION_MODEL=gemini-3.8-flash
## 번역 공급자: 리비전 한국어, 단계 읽기 번역
VOINEY_LAB_TRANSLATION_PROVIDER=google
## 번역 추론
VOINEY_LAB_TRANSLATION_REASONING=low
## 음성 합성 모델
VOINEY_LAB_TTS_MODEL=
## 음성 합성 공급자: xai, google_cloud, elevenlabs
VOINEY_LAB_TTS_PROVIDER=google_cloud
## 음성 합성 요청 제한 시간 (초, 1–300)
VOINEY_LAB_TTS_TIMEOUT_SECONDS=120
## 음성 합성 목소리 (고른 공급자의 이름. 공급자를 바꾸면 함께 바꾼다)
VOINEY_LAB_TTS_VOICE=
## 웹 설명 모델 (OpenAI Responses 의 web_search 도구를 쓰는 모델; 키는 OPENAI_API_KEY)
VOINEY_LAB_WEB_EXPLANATION_MODEL=gpt-6-luna
## 웹 설명 호출 제한 시간 (초, 3–60)
VOINEY_LAB_WEB_EXPLANATION_TIMEOUT_SECONDS=15

## ── 기능 켜기·끄기 ──
## 기다리는 동안 진행 상황을 말로 함 (끄면 톤과 화면만, 줄 XO 결정 7)
VOINEY_LAB_CASCADE_FILLER_STATUS_SPEECH_ENABLED=false
# Lane WV: AI-drawn diagrams ("그림으로 그려 줘"). Switching it on needs OPENAI_API_KEY
# too; without the key the server refuses the connection by name.
## AI 가 그린 도식 (줄 WV 결정 3; 켜면 OPENAI_API_KEY 필수; '그림으로 그려 줘'에만)
VOINEY_LAB_DRAWN_DIAGRAMS_ENABLED=false
# Event-driven experiment records. Use an ignored runtime path in development.
## 실험 기록 장부
VOINEY_LAB_EXPERIMENT_REPORTS_ENABLED=false
## LLM 라우터
VOINEY_LAB_LLM_ROUTER_ENABLED=false
# Optional project-specific read-only Answer/Source/Visual LLM roles. The
# deterministic server remains the sole workflow/report authority. A short
# primary budget prevents these calls from delaying the local answer/TTS.
# Keep disabled until one account/model passes all three role schemas, semantic
# admission, and the concurrent production-transport probe; schema-only success
# is insufficient. The per-role switches (VOINEY_LAB_ANSWER_BRAIN_ENABLED,
# _SOURCE_BRAIN_ENABLED, _VISUAL_BRAIN_ENABLED) follow this one unless set.
## Answer/Source/Visual 모델 역할
VOINEY_LAB_MULTI_BRAIN_ENABLED=false
# Lane RX0: the new React screen (web/) is built into src/voiney_lab/static/app/
# by the launchers (node needed) and always served at /app/. true sends / there;
# false keeps the current screen at /. Without a build, / is the current screen.
## 새 화면(web/, /app/)을 기본으로: true 면 / 가 /app/ 으로 감 (빌드가 없으면 지금 화면 그대로); false 면 지금 화면 그대로이고 /app/ 은 언제나 열림 (줄 RX0)
VOINEY_LAB_NEW_UI=false
# Lane RP3: at a step whose source names what to observe, once when it is
# completed without a description, the run asks "관찰한 것 있으면 말씀해
# 주세요". The answer is recorded at that step; nothing moves. false skips it.
## 종점이 있는 단계를 끝낼 때 '관찰한 것 있으면 말씀해 주세요'를 한 번 묻기 (줄 RP3 결정 ② c)
VOINEY_LAB_NOTEBOOK_OBSERVATION_QUESTION=true
# Optional arbitrary-PDF protocol catalog. The directory must be absolute and
# ignored by Git. Upload/analysis is unavailable while disabled.
## PDF 프로토콜 카탈로그
VOINEY_LAB_PROTOCOL_ENABLED=false
# Lane KNOW (2026-10-24): licence-checked public material (NIOSH, CDC, PubChem,
# OpenStax 1e, Europe PMC CC BY, Wikipedia) searched by Moss inside the server.
# Switching it on needs MOSS_PROJECT_ID and MOSS_PROJECT_KEY above and an index
# uploaded with scripts/public_knowledge_pipeline.py; without them, or when the
# load fails, only this tier is off and the server says which setting is missing.
## 공개 실험·안전·과학 지식(라이선스 확인한 공개 자료) Moss 검색 — 시작 때 색인을 불러오고 질의는 프로세스 안에서; 켜면 MOSS_PROJECT_ID·MOSS_PROJECT_KEY 필수, 없거나 불러오기 실패면 이 등급만 꺼짐 (줄 KNOW 결정 4)
VOINEY_LAB_PUBLIC_KNOWLEDGE_ENABLED=false
## 실험 보고서 서술 모델
VOINEY_LAB_REPORT_WRITER_ENABLED=true
## 라우터 먼저 (줄 RA): 앞 규칙은 시스템 정보·모호한 지칭 되묻기·짧고 분명한 명령·서버 질문의 답만 맡고, 나머지는 LLM 라우터가 answer/change_state/record_log/show_visual/clarify/not_for_me 중 고름 (서버 검사). VOINEY_LAB_LLM_ROUTER_ENABLED=true 가 필요하며, 켜는 것은 사람 음성 시험 뒤 사람이 정함
VOINEY_LAB_ROUTER_FIRST=false
# Lane ON: before the start, two key values of the analysis about to run are
# asked as a multiple choice beside their source excerpt; the server picks the
# values, the choices and the right answer. false skips the step.
## 시작 전 핵심 값 확인 2문항 (실행할 분석의 시간·온도·속도·양 값을 원문 조각과 함께 객관식으로; 서버가 정답과 선택지를 정함; 줄 ON 결정 ③)
VOINEY_LAB_START_CHECK_ENABLED=true
# Opt-in local real-voice STT evidence. Disabled means no audio is retained.
# When enabled, both WAV and sanitized metadata (with the transcript) stay under
# the ignored runtime tree and the oldest pairs are deleted after the bounded
# limit. The pilot launcher keeps them inside data/runtime/pilot/, where
# scripts/pilot_data_delete.py finds them.
## 실제 음성 STT 진단 녹음 보관
VOINEY_LAB_STT_DIAGNOSTICS_ENABLED=false
# The short outside-PDF explanation shown as "AI 일반 지식" (the general
# explanation, e.g. "HPLC water 가 뭐야?"). It is never protocol evidence and
# cannot answer operations. Switching it on needs the supplemental role's
# provider and model above (an unset one is refused by name). scripts/run_dev.sh
# turns it on unless the shell or this file sets it; scripts/run_pilot.sh keeps it
# off unless the shell or this file sets it.
## 보조 모델 지식 설명
VOINEY_LAB_SUPPLEMENTAL_MODEL_KNOWLEDGE_ENABLED=false
# Lane WV: the web explanation and photos (OpenAI web search, Wikimedia Commons
# photos). Switching it on needs OPENAI_API_KEY too. The experimenter can also
# turn it off on the screen ("웹 찾아보기").
## 웹 설명·사진 (줄 WV 결정 2; 켜면 OPENAI_API_KEY 필수. 실험자 설정 '웹 찾아보기'로도 끔)
VOINEY_LAB_WEB_EXPLANATIONS_ENABLED=false
## 웹 설명과 함께 Wikimedia Commons 의 라이선스 분명한 사진을 찾음 (웹 설명이 켜졌을 때만)
VOINEY_LAB_WEB_PHOTOS_ENABLED=true
# Optional tenant workspace (experiment sessions, recovery, reports). Both data
# stores must use absolute, ignored runtime directories. A non-operational
# scope has one development identity, the experimenter (lane DI, 2026-10-08).
## 작업공간 (조직·권한·연동)
VOINEY_LAB_WORKSPACE_ENABLED=false

## ── 경로·저장소 ──
## 실험 기록 SQLite
VOINEY_LAB_EXPERIMENT_REPORT_DB=/absolute/ignored/runtime/experiment_reports.sqlite
# LibreOffice must be installed on the server, with fonts-nanum for Korean
# documents (docs/SOURCE_FORMATS.md). Empty: found on PATH or in its default
# install place. Without it a .docx upload is refused (docx_conversion_unavailable).
## LibreOffice soffice 경로 — .docx 원문을 PDF 로 바꿈, 서버에 설치 필수 (줄 AN, FM)
VOINEY_LAB_OFFICE_CONVERTER=
# Absolute and ignored by Git. scripts/run_dev.sh and scripts/run_pilot.sh set the
# three data paths (protocol catalog, reports, workspace) themselves, each to its
# own folder, so the pilot's data and the development data are never mixed.
## 프로토콜 카탈로그 데이터 폴더 (절대 경로)
VOINEY_LAB_PROTOCOL_DATA_DIR=/absolute/ignored/runtime/protocol-catalog
## 공개 지식 Moss 색인 이름 (scripts/public_knowledge_pipeline.py upload --index 로 올린 것)
VOINEY_LAB_PUBLIC_KNOWLEDGE_INDEX=voiney-public-knowledge
# The approved safety catalog (SQLite, absolute path), required by every usage
# scope except source_protocol_only, which neither needs nor reads one.
# For development, build the fictional demo catalog the way CI does and use scope demo:
#   python scripts/ingest_safety_documents.py \
#     --manifest data/moss_demo/approved_documents.ko.json --db /absolute/path/demo.sqlite
# scripts/run_pilot.sh ignores this and the scope below: it looks for
# data/runtime/pilot/approved_safety_catalog.sqlite itself.
## 승인 안전 문서 카탈로그 SQLite (절대 경로)
VOINEY_LAB_SAFETY_CATALOG=/absolute/path/to/approved_catalog.sqlite
# Where the STT diagnostic recordings go; empty is data/runtime/stt-diagnostics.
# A folder must be under data/runtime. scripts/run_pilot.sh pins it inside the pilot folder.
## STT 진단 녹음 폴더 (data/runtime 아래만)
VOINEY_LAB_STT_DIAGNOSTIC_DIR=
## 작업공간 데이터 폴더 (절대 경로)
VOINEY_LAB_WORKSPACE_DATA_DIR=/absolute/ignored/runtime/workspace

## ── 그 밖 ──
# Required to access GET /api/admin/metrics; empty keeps it closed. Use a long
# random secret from a secret manager; never place a real token in a committed file.
## GET /api/admin/metrics 관리자 토큰
VOINEY_LAB_ADMIN_TOKEN=
## 허용 세션 언어
VOINEY_LAB_ALLOWED_LANGUAGES=ko,en,vi
## 작업공간 분석 보관 일수 (1–3650)
VOINEY_LAB_ANALYTICS_RETENTION_DAYS=90
# Lane APP1: the origins of the store app's bundled screen. Only these get the
# session token in the login answer (no cookie) and send it back as
# Authorization: Bearer and as the first /ws message; /api answers them with
# CORS (no credentials) and /ws accepts them. Empty keeps today's behaviour.
## 앱에 묶은 화면의 출처 (쉼표로, 예: https://localhost,capacitor://localhost) — 이 출처에만 로그인 응답에 세션 토큰을 주고 Authorization: Bearer 와 /ws 첫 메시지로 받으며, /api CORS 와 /ws 출처 검사에서 허용 (쿠키는 넘기지 않음; 줄 APP1 결정 ③④)
VOINEY_LAB_APP_ORIGINS=
# Lane ON: the pilot's login. accounts puts a session cookie in front of every
# /api request and /ws (health paths excepted); people join only through an
# invite link made with scripts/pilot_invite.py. dev keeps the one development
# identity, as before. accounts needs VOINEY_LAB_WORKSPACE_ENABLED=true.
## 로그인 방식: dev(개발 신원 자동, 지금 그대로) / accounts(초대 링크로 가입한 계정으로 로그인 — HTTP API·웹소켓 모두 필요, 건강 확인 경로 제외; 작업공간 필요; 줄 ON 결정 ①)
VOINEY_LAB_AUTH_MODE=dev
# Cascade keeps a longer interruption-only prefix without changing idle turns.
## 끼어들기 때 말 앞부분 보존 (ms)
VOINEY_LAB_CASCADE_BARGE_IN_PREFIX_MS=800
## 기다림 신호까지의 시간 (ms, 100–5000)
VOINEY_LAB_CASCADE_FILLER_DELAY_MS=700
## 기다림 신호: tone 또는 phrase
VOINEY_LAB_CASCADE_FILLER_MODE=tone
## 진행 상황을 말하기까지의 시간 (ms, 200–10000)
VOINEY_LAB_CASCADE_FILLER_STATUS_DELAY_MS=1500
## 발화 사이 쉬는 시간 (ms)
VOINEY_LAB_CASCADE_VAD_COOLDOWN_MS=300
## 말 끝 판정 침묵 (ms)
VOINEY_LAB_CASCADE_VAD_ENDPOINT_SILENCE_MS=1000
## 듣기 중 말 시작 판정: 유성 프레임 수
VOINEY_LAB_CASCADE_VAD_LISTENING_ONSET_VOICED_FRAMES=8
## 듣기 중 말 시작 판정: 창 프레임 수
VOINEY_LAB_CASCADE_VAD_LISTENING_ONSET_WINDOW_FRAMES=12
## 듣기 재개 판정: 유성 프레임 수
VOINEY_LAB_CASCADE_VAD_LISTENING_RESUME_VOICED_FRAMES=6
## 듣기 재개 판정: 창 프레임 수
VOINEY_LAB_CASCADE_VAD_LISTENING_RESUME_WINDOW_FRAMES=10
## 최대 발화 길이 (ms)
VOINEY_LAB_CASCADE_VAD_MAX_UTTERANCE_MS=15000
## 최소 발화 길이 (ms)
VOINEY_LAB_CASCADE_VAD_MIN_SPEECH_MS=240
## 음성 감지 민감도 (0–3)
VOINEY_LAB_CASCADE_VAD_MODE=3
## 말 시작 판정: 유성 프레임 수
VOINEY_LAB_CASCADE_VAD_ONSET_VOICED_FRAMES=4
## 말 시작 판정: 창 프레임 수
VOINEY_LAB_CASCADE_VAD_ONSET_WINDOW_FRAMES=6
## 재생 중 말 시작 판정: 유성 프레임 수
VOINEY_LAB_CASCADE_VAD_PLAYBACK_ONSET_VOICED_FRAMES=12
## 재생 중 말 시작 판정: 창 프레임 수
VOINEY_LAB_CASCADE_VAD_PLAYBACK_ONSET_WINDOW_FRAMES=15
## 말 앞부분 보존 (ms)
VOINEY_LAB_CASCADE_VAD_PREFIX_MS=300
## 시설 ID
VOINEY_LAB_FACILITY_ID=
## OIDC 대상
VOINEY_LAB_OIDC_AUDIENCE=
# Operational workspace mode requires all three OIDC values. Tokens must use a
# verified RS256/ES256 signature and include issuer, audience, exp, iat, sub,
# tenant, and roles claims. The local membership remains an additional gate.
## OIDC 발급자 (셋 함께, https)
VOINEY_LAB_OIDC_ISSUER=
## OIDC JWKS 주소 (https)
VOINEY_LAB_OIDC_JWKS_URL=
## OIDC 이름 클레임
VOINEY_LAB_OIDC_NAME_CLAIM=name
## OIDC 조직 클레임
VOINEY_LAB_OIDC_TENANT_CLAIM=organization_id
## PDF 읽기 하위 프로세스 제한 시간 (초, 1–600; 긴 문서를 받는 서버는 300 권고, docs/DEPLOYMENT_RUNBOOK.md)
VOINEY_LAB_PDF_WORKER_TIMEOUT_SECONDS=30
## 실험 보고서에 쓰는 연구자 시간대 (IANA 이름)
VOINEY_LAB_REPORT_TIMEZONE=Asia/Seoul
## 기본 세션 언어
VOINEY_LAB_SESSION_LANGUAGE=ko
## STT 진단 녹음 최대 개수 (2–100)
VOINEY_LAB_STT_DIAGNOSTIC_MAX_FILES=20
# Required server policy. demo and test_only are development material (the in-gel
# development fixture runs under them and reference_only); operational needs OIDC;
# source_protocol_only is for a run with no institution safety documents: the
# uploaded PDF's own safety statements only, and every safety answer, the start
# screen and the record say "기관 안전 문서 없음 · 원문 안전 주의만".
## 사용 범위: operational/demo/reference_only/test_only/source_protocol_only (source_protocol_only: 기관 안전 문서 없음, 원문 안전 주의만 — 승인 카탈로그를 읽지 않음)
VOINEY_LAB_USAGE_SCOPE=demo
