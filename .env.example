XAI_API_KEY=replace-with-your-key
XAI_BASE_URL=https://api.x.ai/v1
VOINEY_LAB_XAI_STT_VAD_THRESHOLD=0.5
VOINEY_LAB_XAI_STT_FILLER_WORDS=0
VOINEY_LAB_CASCADE_VAD_MODE=3
VOINEY_LAB_CASCADE_VAD_ONSET_VOICED_FRAMES=4
VOINEY_LAB_CASCADE_VAD_ONSET_WINDOW_FRAMES=6
VOINEY_LAB_CASCADE_VAD_PREFIX_MS=300
VOINEY_LAB_CASCADE_VAD_ENDPOINT_SILENCE_MS=1000
VOINEY_LAB_CASCADE_VAD_MIN_SPEECH_MS=240
VOINEY_LAB_CASCADE_VAD_MAX_UTTERANCE_MS=15000
VOINEY_LAB_CASCADE_VAD_COOLDOWN_MS=300
VOINEY_LAB_CHAT_MODEL=grok-4
VOINEY_LAB_WORKER_MODEL=grok-4
VOINEY_LAB_PROTOCOL_ANALYSIS_MODEL=grok-4.6
VOINEY_LAB_PROTOCOL_ANALYSIS_REASONING_EFFORT=high
# The current product uses the Cascade STT -> agent -> TTS path only.
# Leo is the documented calm, authoritative default; custom xAI voice IDs work.
VOINEY_LAB_TTS_VOICE=leo
VOINEY_LAB_LAB_MANAGER_EMAIL=lab-manager@example.invalid
VOINEY_LAB_FROM_EMAIL=voice_workflow_agent@example.invalid

# Required server policy. Use absolute paths for catalog files.
VOINEY_LAB_SAFETY_CATALOG=/absolute/path/to/approved_catalog.sqlite
VOINEY_LAB_USAGE_SCOPE=test_only
VOINEY_LAB_FACILITY_ID=
VOINEY_LAB_SESSION_LANGUAGE=ko
VOINEY_LAB_ALLOWED_LANGUAGES=ko,en,vi

# Optional arbitrary-PDF protocol catalog. The directory must be absolute and
# ignored by Git. Upload/analysis is unavailable while disabled.
VOINEY_LAB_PROTOCOL_ENABLED=false
VOINEY_LAB_PROTOCOL_DATA_DIR=/absolute/ignored/runtime/protocol-catalog
# Explicit convenience for demo/reference/test scopes only; operational scope
# always disables automatic development activation.
VOINEY_LAB_AUTO_ACTIVATE_READY_UPLOADS=false

# Optional tenant/RBAC/source workspace. Both data stores must use absolute,
# ignored runtime directories. Non-operational scope has one allowlisted local
# lab-admin profile by default; provide an explicit JSON profile list to model
# researcher/reviewer/admin roles in a demo.
VOINEY_LAB_WORKSPACE_ENABLED=false
VOINEY_LAB_WORKSPACE_DATA_DIR=/absolute/ignored/runtime/workspace
VOINEY_LAB_ANALYTICS_RETENTION_DAYS=90
VOINEY_LAB_DEV_AUTH_PROFILES=

# Operational workspace mode requires all three OIDC values. Tokens must use a
# verified RS256/ES256 signature and include issuer, audience, exp, iat, sub,
# tenant, and roles claims. The local membership remains an additional gate.
VOINEY_LAB_OIDC_ISSUER=
VOINEY_LAB_OIDC_AUDIENCE=
VOINEY_LAB_OIDC_JWKS_URL=
VOINEY_LAB_OIDC_TENANT_CLAIM=organization_id
VOINEY_LAB_OIDC_ROLES_CLAIM=roles
VOINEY_LAB_OIDC_NAME_CLAIM=name

# Connector rows store opaque secret:// references only. This JSON maps each
# reference to a server-side environment-variable NAME; it must never contain an
# access token itself. Define the named variables in the process secret manager.
VOINEY_LAB_SECRET_REFERENCES={}

# Optional procedure support. Set both paths or leave both empty.
VOINEY_LAB_PROCEDURE_CATALOG=
VOINEY_LAB_PROCEDURE_STORE=

# Optional Moss in-memory retrieval. Keep disabled until a reviewed index exists.
VOINEY_LAB_MOSS_ENABLED=false
VOINEY_LAB_MOSS_PROJECT_ID=replace-with-moss-project-id
VOINEY_LAB_MOSS_PROJECT_KEY=replace-with-moss-project-key
VOINEY_LAB_MOSS_INDEX_NAME=voice_workflow_agent-approved-safety
VOINEY_LAB_MOSS_MODEL_ID=moss-minilm

VOINEY_LAB_MOSS_ALLOWED_SCOPES=demo,reference_only
VOINEY_LAB_MOSS_ALPHA=0.65
VOINEY_LAB_MOSS_CANDIDATE_LIMIT=64
VOINEY_LAB_MOSS_QUERY_TIMEOUT_MS=250
VOINEY_LAB_MOSS_LOAD_TIMEOUT_SECONDS=60
VOINEY_LAB_MOSS_AUTO_REFRESH=false
VOINEY_LAB_MOSS_REFRESH_SECONDS=600

# Optional, read-only authoritative references. A profile or 1-5 explicit
# HTTPS domains is required; do not place credentials in these values.
VOINEY_LAB_EXTERNAL_REFERENCES_ENABLED=false
VOINEY_LAB_EXTERNAL_REFERENCE_DOMAIN_PROFILE=candidate_a
VOINEY_LAB_EXTERNAL_REFERENCE_MODEL=grok-4.6
VOINEY_LAB_EXTERNAL_REFERENCE_TIMEOUT_SECONDS=20
VOINEY_LAB_EXTERNAL_REFERENCE_CONNECT_TIMEOUT_SECONDS=3
VOINEY_LAB_EXTERNAL_REFERENCE_READ_TIMEOUT_SECONDS=15
VOINEY_LAB_EXTERNAL_REFERENCE_CACHE_TTL_SECONDS=900
VOINEY_LAB_EXTERNAL_REFERENCE_MAX_CITATIONS=5
VOINEY_LAB_EXTERNAL_REFERENCE_ALLOWED_DOMAINS=
VOINEY_LAB_EXTERNAL_REFERENCE_ENRICHMENT_BUDGET_SECONDS=4

# Optional project-specific read-only Answer/Source/Visual LLM roles. The
# deterministic server remains the sole workflow/report authority. A short
# primary budget prevents these calls from delaying the local answer/TTS.
# Keep disabled until one account/model passes all three role schemas, semantic
# admission, and the concurrent production-transport probe; schema-only success
# is insufficient.
VOINEY_LAB_MULTI_BRAIN_ENABLED=false
VOINEY_LAB_MULTI_BRAIN_MODEL=grok-4.6
VOINEY_LAB_ANSWER_BRAIN_PRIMARY_BUDGET_SECONDS=1.25
VOINEY_LAB_ANSWER_BRAIN_TIMEOUT_SECONDS=8
VOINEY_LAB_PLANNER_BRAIN_TIMEOUT_SECONDS=6

# Optional bounded semantic intent fallback. It runs only when deterministic
# routing returns a catch-all (off-topic / unsupported / generic related
# question), and it may only PROPOSE one of the existing bounded workflow
# actions. Server-owned policy re-validates every proposal, a completion
# proposal is downgraded to an explicit researcher confirmation, and any
# timeout, outage, or malformed output falls back to the deterministic outcome.
# The code default remains disabled. This development example enables the
# bounded fallback for explicit evaluation; deployment environments should set
# this deliberately after reviewing turn.route_decision.semantic_fallback.
VOINEY_LAB_SEMANTIC_INTENT_ENABLED=true
VOINEY_LAB_SEMANTIC_INTENT_MODEL=grok-4.20-0309-non-reasoning
VOINEY_LAB_SEMANTIC_INTENT_TIMEOUT_SECONDS=2.5
VOINEY_LAB_SEMANTIC_INTENT_MIN_CONFIDENCE=0.6
VOINEY_LAB_SEMANTIC_INTENT_MUTATION_MIN_CONFIDENCE=0.85

# Optional general Grok explanation after every admitted authoritative tier
# is insufficient. This is never protocol evidence and cannot answer operations.
VOINEY_LAB_SUPPLEMENTAL_MODEL_KNOWLEDGE_ENABLED=false
VOINEY_LAB_SUPPLEMENTAL_MODEL_KNOWLEDGE_MODEL=grok-4.6
VOINEY_LAB_SUPPLEMENTAL_MODEL_KNOWLEDGE_TIMEOUT_SECONDS=8

# Explicit web-image discovery returns a source link unless display rights and
# safely proxied bytes can be verified. It never hotlinks a remote image.
VOINEY_LAB_WEB_VISUAL_SEARCH_ENABLED=false

# Explicit instructional image generation only; never automatic per step.
VOINEY_LAB_GENERATED_VISUALS_ENABLED=false

# Cascade keeps a longer interruption-only prefix without changing idle turns.
VOINEY_LAB_CASCADE_BARGE_IN_PREFIX_MS=800
VOINEY_LAB_GENERATED_VISUAL_MODEL=grok-imagine-image-quality
VOINEY_LAB_GENERATED_VISUAL_TIMEOUT_SECONDS=60

# Event-driven experiment records. Use an ignored runtime path in development.
VOINEY_LAB_EXPERIMENT_REPORTS_ENABLED=false
VOINEY_LAB_EXPERIMENT_REPORT_DB=/absolute/ignored/runtime/experiment_reports.sqlite

# Required to access GET /api/admin/metrics. Use a long random secret in a
# secret manager; never place a real token in a committed environment file.
VOINEY_LAB_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Opt-in local real-voice STT evidence. Disabled means no audio is retained.
# When enabled, both WAV and sanitized metadata stay under the ignored runtime
# tree and oldest pairs are deleted after the bounded limit.
VOINEY_LAB_STT_DIAGNOSTICS_ENABLED=false
VOINEY_LAB_STT_DIAGNOSTIC_DIR=/absolute/path/inside/repository/data/runtime/stt-diagnostics
VOINEY_LAB_STT_DIAGNOSTIC_MAX_FILES=20

VOINEY_LAB_PROTOCOL_CLAIM_CHUNKS_ENABLED=false

# Optional OCR for pages with no usable text layer (scans). List one or both
# engines: clova (NAVER CLOVA OCR, Korean and handwriting), google (Google
# Cloud Vision, English). Leave a value empty to disable that engine; with
# none configured the OCR endpoint returns protocol_ocr_not_configured.
VOINEY_LAB_OCR_PROVIDERS=
VOINEY_LAB_CLOVA_OCR_INVOKE_URL=
VOINEY_LAB_CLOVA_OCR_SECRET=
VOINEY_LAB_GOOGLE_VISION_API_KEY=
