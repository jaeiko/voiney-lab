XAI_API_KEY=replace-with-your-key
XAI_BASE_URL=https://api.x.ai/v1
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_REALTIME_MODEL=grok-voice-latest
XAI_REALTIME_VOICE=eve
XAI_REALTIME_VAD_THRESHOLD=0.6
CHAT_MODEL=grok-4
WORKER_MODEL=grok-4
TTS_VOICE=replace-with-an-xai-voice-id
LAB_MANAGER_EMAIL=lab-manager@example.invalid
SAFEBRIDGE_FROM_EMAIL=safebridge@example.invalid

# Optional Moss in-memory retrieval. Keep disabled until a reviewed index exists.
SAFEBRIDGE_MOSS_ENABLED=false
MOSS_PROJECT_ID=replace-with-moss-project-id
MOSS_PROJECT_KEY=replace-with-moss-project-key
MOSS_INDEX_NAME=safebridge-approved-safety
MOSS_MODEL_ID=moss-minilm
SAFEBRIDGE_MOSS_ALLOWED_SCOPES=demo,reference_only
SAFEBRIDGE_MOSS_ALPHA=0.65
SAFEBRIDGE_MOSS_CANDIDATE_LIMIT=64
SAFEBRIDGE_MOSS_QUERY_TIMEOUT_MS=250
SAFEBRIDGE_MOSS_LOAD_TIMEOUT_SECONDS=60
SAFEBRIDGE_MOSS_AUTO_REFRESH=false
SAFEBRIDGE_MOSS_REFRESH_SECONDS=600
